.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 20rpx;
}

/* 返回按钮 */
.back-btn {
  position: fixed;
  left: 30rpx;
  width: 120rpx;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  -webkit-tap-highlight-color: transparent;
  user-select: none;
  -webkit-user-select: none;
}

.back-btn-hover {
  /* 点击时无视觉效果 */
}

.back-icon {
  width: 100%;
  display: block;
  filter: drop-shadow(0 0 8rpx white);
}

.loading,
.empty {
  display: flex;
  justify-content: center;
  align-items: center;
  color: #999;
  font-size: 28rpx;
}

.news-list {
  padding: 0rpx;
  -webkit-overflow-scrolling: touch;
}

.news-item {
  margin: 30rpx;
  background-color: #fff;
  border-radius: 6rpx;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
  transition: all 0.3s ease;
  overflow: hidden;
}

.news-item-hover {
  transform: scale(0.98);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.12);
}

/* 封面图片 */
.news-cover {
  width: 100%;
  height: 360rpx;
  display: block;
  background-color: #f5f5f5;
}

/* 内容区域 */
.news-content {
  padding: 24rpx;
  margin: 0 !important;
}

.news-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
  margin: 0;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
