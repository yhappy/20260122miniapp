.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 20rpx;
}

/* 返回按钮 */
.back-btn {
  position: fixed;
  left: 30rpx;
  width: 120rpx;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  -webkit-tap-highlight-color: transparent;
  user-select: none;
  -webkit-user-select: none;
}

.back-btn-hover {
  /* 点击时无视觉效果 */
}

.back-icon {
  width: 100%;
  display: block;
  filter: drop-shadow(0 0 8rpx white);
}

.loading,
.empty {
  display: flex;
  justify-content: center;
  align-items: center;
  color: #999;
  font-size: 28rpx;
}

.news-list {
  padding: 0rpx;
  -webkit-overflow-scrolling: touch;
}

/* ===== 顶部前两个稿件 - 并排显示 ===== */
.top-news-container {
  display: flex;
  justify-content: space-between;
  padding: 30rpx;
  gap: 20rpx;
}

.top-news-item {
  flex: 1;
  background-color: #fff;
  border-radius: 6rpx;
  overflow: hidden;
  transition: all 0.3s ease;
}

.top-news-item-hover {
  transform: scale(0.98);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.12);
}

.top-news-cover {
  width: 100%;
  height: 250rpx;
  display: block;
  background-color: #f5f5f5;
}

.top-news-title {
  padding: 16rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  max-height: 65rpx;
}

/* ===== 分隔图片 ===== */
.separator-image {
  padding: 0 20rpx 20rpx 30rpx;
  display: flex;
  justify-content: left;
}

.separator-image image {
  width: 30%;
  display: block;
}

/* ===== 底部剩余稿件列表 ===== */
.bottom-news-list {
  padding: 0 30rpx;
}

.bottom-news-item {
  display: flex;
  background-color: #fff;
  border-radius: 6rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  transition: all 0.3s ease;
}

.bottom-news-item-hover {
  transform: scale(0.98);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.12);
}

.bottom-news-cover {
  width: 240rpx;
  height: 180rpx;
  flex-shrink: 0;
  display: block;
  background-color: #f5f5f5;
  margin: 10rpx 0 10rpx 10rpx;
}

.bottom-news-title {
  flex: 1;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  overflow: hidden;
  max-height: 145rpx;
}