<view class="container">
  <!-- 返回按钮 -->
  <view class="back-btn" style="top: {{backButtonTop + 14}}rpx" hover-class="back-btn-hover" hover-stay-time="50"
    bindtap="goBack">
    <image class="back-icon" src="https://app5.fjsen.com/h5/20260122/images/back.png" mode="widthFix"></image>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}" style="padding-top: calc({{backButtonTop}}rpx + 188rpx)">
    <text>加载中...</text>
  </view>

  <!-- 新闻列表 -->
  <scroll-view class="news-list" scroll-y wx:elif="{{newsList.length > 0}}" style="padding-top: calc({{backButtonTop}}rpx + 60rpx)">

    <!-- 顶部前两个稿件 - 并排显示 -->
    <view class="top-news-container" wx:if="{{newsList.length >= 2}}">
      <!-- 第1个稿件 -->
      <view class="top-news-item" data-item="{{newsList[0]}}"
        bindtap="onNewsTap" hover-class="news-item-hover" hover-stay-time="50">
        <image class="top-news-cover" src="{{newsList[0].imgUrl}}" mode="aspectFill" lazy-load="{{true}}"></image>
        <view class="top-news-title">{{newsList[0].title}}</view>
      </view>

      <!-- 第2个稿件 -->
      <view class="top-news-item" data-item="{{newsList[1]}}"
        bindtap="onNewsTap" hover-class="news-item-hover" hover-stay-time="50">
        <image class="top-news-cover" src="{{newsList[1].imgUrl}}" mode="aspectFill" lazy-load="{{true}}"></image>
        <view class="top-news-title">{{newsList[1].title}}</view>
      </view>
    </view>

    <!-- 分隔图片 -->
    <view class="separator-image">
      <image src="https://app5.fjsen.com/h5/20260122/images/闽式生活资讯.png" mode="widthFix"></image>
    </view>

    <!-- 剩余稿件列表 -->
    <view class="bottom-news-list">
      <view
        class="bottom-news-item"
        wx:for="{{newsList}}"
        wx:for-index="idx"
        wx:key="id"
        wx:if="{{idx >= 2}}"
        data-item="{{item}}"
        bindtap="onNewsTap"
        hover-class="news-item-hover"
        hover-stay-time="50"
      >
        <image class="bottom-news-cover" src="{{item.imgUrl}}" mode="aspectFill" lazy-load="{{true}}"></image>
        <view class="bottom-news-title">{{item.title}}</view>
      </view>
    </view>
  </scroll-view>

  <!-- 空状态 -->
  <view class="empty" wx:else style="padding-top: calc({{backButtonTop}}rpx + 188rpx)">
    <text>暂无新闻数据</text>
  </view>
</view>
